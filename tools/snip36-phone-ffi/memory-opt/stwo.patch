+/// Bench: `build_leaves` split into per-chunk steps. Hashing is row-wise and lifting maps lifted
+/// row `i` to source row `i >> ratio`, so absorbing each 16-column chunk at its own size and
+/// lifting the states later yields the same leaves as lifting every chunk to its window's size.
+struct SimdLeafStream<const IS_M31_OUTPUT: bool> {
+    prev_layer_states: Vec<[u32x16; N_FELTS_IN_BLAKE_STATE]>,
+    next_layer_states: Vec<[u32x16; N_FELTS_IN_BLAKE_STATE]>,
+    /// Packed log size of the rows in `prev_layer_states`.
+    prev_log_size: u32,
+    max_log_size: u32,
+    byte_count: u64,
+}
+
+impl<const IS_M31_OUTPUT: bool> SimdLeafStream<IS_M31_OUTPUT> {
+    #[allow(clippy::uninit_vec)]
+    fn new(max_log_size: u32) -> Self {
+        // Safety: rows are only read after being written; row 0 is the only row read while
+        // `prev_log_size == 0`.
+        let mut prev_layer_states = unsafe { uninit_vec(1 << max_log_size) };
+        prev_layer_states[0] = INITIAL_STATE;
+        Self {
+            prev_layer_states,
+            next_layer_states: unsafe { uninit_vec(1 << max_log_size) },
+            prev_log_size: 0,
+            max_log_size,
+            byte_count: 0,
+        }
+    }
+}
+
+impl<const IS_M31_OUTPUT: bool> LeafStream<SimdBackend, Blake2sMerkleHasherGeneric<IS_M31_OUTPUT>>
+    for SimdLeafStream<IS_M31_OUTPUT>
+{
+    fn absorb_chunk(&mut self, columns: &[&BaseColumn]) {
+        assert_eq!(columns.len(), N_FELTS_IN_BLAKE_MESSAGE);
+        let chunk_log_size = columns.last().unwrap().data.len().ilog2();
+        assert!(chunk_log_size >= self.prev_log_size);
+        self.byte_count += N_BYTES_IN_BLAKE_MESSAGE;
+        let byte_count = self.byte_count;
+        let msgs_at = |i: usize| -> [u32x16; N_FELTS_IN_BLAKE_MESSAGE] {
+            std::array::from_fn(|j| {
+                let column = columns[j];
+                let log_ratio = chunk_log_size - column.data.len().ilog2();
+                to_lifted_simd(column.data[i >> log_ratio].into_simd(), log_ratio, i)
+            })
+        };
+        let log_ratio = chunk_log_size - self.prev_log_size;
+        if log_ratio == 0 {
+            self.prev_layer_states[..1 << chunk_log_size]
+                .par_iter_mut()
+                .enumerate()
+                .for_each(|(i, state)| *state = compress_unfinalized(*state, msgs_at(i), byte_count));
+            return;
+        }
+        let prev_layer_states = &self.prev_layer_states;
+        self.next_layer_states[..1 << chunk_log_size]
+            .par_iter_mut()
+            .enumerate()
+            .for_each(|(i, state)| {
+                let prev_state = std::array::from_fn(|j| {
+                    to_lifted_simd(prev_layer_states[i >> log_ratio][j], log_ratio, i)
+                });
+                *state = compress_unfinalized(prev_state, msgs_at(i), byte_count);
+            });
+        std::mem::swap(&mut self.prev_layer_states, &mut self.next_layer_states);
+        self.prev_log_size = chunk_log_size;
+    }
+
+    #[allow(clippy::uninit_vec)]
+    fn finalize(self: Box<Self>, columns: &[&BaseColumn], lifting_log_size: u32) -> Vec<Blake2sHash> {
+        let Self {
+            prev_layer_states,
+            mut next_layer_states,
+            prev_log_size,
+            max_log_size,
+            byte_count,
+        } = *self;
+        assert!(!columns.is_empty() && columns.len() <= N_FELTS_IN_BLAKE_MESSAGE);
+        assert_eq!(columns.last().unwrap().data.len().ilog2(), max_log_size);
+        let byte_count = byte_count + (columns.len() * N_BYTES_FELT) as u64;
+        let log_ratio = max_log_size - prev_log_size;
+        next_layer_states[..1 << max_log_size]
+            .par_iter_mut()
+            .enumerate()
+            .for_each(|(i, state)| {
+                let prev_state = std::array::from_fn(|j| {
+                    to_lifted_simd(prev_layer_states[i >> log_ratio][j], log_ratio, i)
+                });
+                let mut msgs: [u32x16; N_FELTS_IN_BLAKE_MESSAGE] = unsafe { std::mem::zeroed() };
+                for (j, column) in columns.iter().enumerate() {
+                    let log_ratio = max_log_size - column.data.len().ilog2();
+                    msgs[j] = to_lifted_simd(column.data[i >> log_ratio].into_simd(), log_ratio, i);
+                }
+                *state = compress_finalize(prev_state, msgs, byte_count);
+            });
+        drop(prev_layer_states);
+
+        let lifting_log_size_packed = lifting_log_size - LOG_N_LANES;
+        let mut res: Vec<Blake2sHash> =
+            unsafe { uninit_vec(1 << (lifting_log_size_packed + LOG_N_HASHES_PER_SIMD_STATE)) };
+        let mut transposed_states = if lifting_log_size_packed == max_log_size {
+            next_layer_states
+        } else {
+            let mut buf: Vec<[u32x16; N_FELTS_IN_BLAKE_STATE]> =
+                unsafe { uninit_vec(1 << lifting_log_size_packed) };
+            let log_ratio = lifting_log_size_packed - max_log_size;
+            buf.par_iter_mut().enumerate().for_each(|(i, dest)| {
+                let packed = next_layer_states[i >> log_ratio];
+                *dest = std::array::from_fn(|j| to_lifted_simd(packed[j], log_ratio, i));
+            });
+            buf
+        };
+        transposed_states
+            .par_iter_mut()
+            .zip(res.par_chunks_exact_mut(1 << LOG_N_HASHES_PER_SIMD_STATE))
+            .for_each(|(state, dst)| {
+                let untransposed = if IS_M31_OUTPUT {
+                    let tmp = untranspose_states(*state);
+                    std::array::from_fn(|i| reduce_to_m31_simd(tmp[i]))
+                } else {
+                    untranspose_states(*state)
+                };
+                let dst: &mut [Blake2sHash; 16] = dst.try_into().unwrap();
+                *dst = unsafe { transmute::<[u32x16; 8], [Blake2sHash; 16]>(untransposed) };
+            });
+        res
+    }
 }
 

+/// Bench: block `block` of the bit-reversed evaluation of `poly` on `domain`, i.e. the evaluation
+/// on one subdomain coset of the polynomial's size (what `evaluate_into` writes per iteration).
+pub fn bench_evaluate_block(
+    poly: &CircleCoefficients<SimdBackend>,
+    domain: CircleDomain,
+    twiddles: &TwiddleTree<SimdBackend>,
+    block: usize,
+) -> BaseColumn {
+    let fft_log_size = poly.log_size();
+    let block_size = 1usize << fft_log_size;
+    if fft_log_size < MIN_FFT_LOG_SIZE {
+        let full = SimdBackend::evaluate(poly, domain, twiddles).values.to_cpu();
+        return full[block * block_size..(block + 1) * block_size].iter().copied().collect();
+    }
+    let line_twiddles = domain_line_twiddles_from_tree(domain, &twiddles.twiddles);
+    let block_twiddles = (0..(fft_log_size - 1))
+        .map(|layer_i| {
+            &line_twiddles[layer_i as usize]
+                [block << (fft_log_size - 2 - layer_i)..(block + 1) << (fft_log_size - 2 - layer_i)]
+        })
+        .collect::<Vec<_>>();
+    // SAFETY: the FFT writes every value.
+    let mut out = unsafe { BaseColumn::uninitialized(block_size) };
+    unsafe {
+        rfft::fft(
+            transmute::<*const PackedBaseField, *const u32>(poly.coeffs.data.as_ptr()),
+            transmute::<*mut PackedBaseField, *mut u32>(out.data.as_mut_ptr()),
+            &block_twiddles,
+            fft_log_size as usize,
+        );
+    }
+    out
+}

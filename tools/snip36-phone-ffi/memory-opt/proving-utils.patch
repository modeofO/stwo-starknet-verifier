+/// Memory optimization, fixed at compile time (`stwo::prover::memopt`): build each preprocessed
+/// tree inside the proof that uses it (owned, so its buffers go back to the pool), instead of
+/// holding both from setup on.
+fn lazy_trees() -> bool {
+    stwo::prover::memopt::LAZY_TREES
+}
+
+fn build_cairo_preprocessed_tree(
+    trace: &Arc<PreProcessedTrace>,
+    twiddles: &TwiddleTree<SimdBackend>,
+    pool: &BaseColumnPool<SimdBackend>,
+) -> CommitmentTreeProver<SimdBackend, Blake2sM31MerkleChannel> {
+    let _span = span!(Level::INFO, "build cairo preprocessed tree").entered();
+    let polys = SimdBackend::interpolate_columns(gen_trace(trace.clone()), twiddles);
+    CommitmentTreeProver::new(
+        polys,
+        CAIRO_PCS_CONFIG.fri_config.log_blowup_factor,
+        twiddles,
+        CAIRO_PROVER_PARAMS.store_polynomials_coefficients,
+        CAIRO_PROVER_PARAMS.pcs_config.lifting_log_size,
+        pool,
+    )
+}
+
+fn build_circuit_preprocessed_tree(
+    preprocessed_circuit: &PreprocessedCircuit,
+    circuit_config: &CircuitConfig,
+    twiddles: &TwiddleTree<SimdBackend>,
+    pool: &BaseColumnPool<SimdBackend>,
+) -> CommitmentTreeProver<SimdBackend, Blake2sM31MerkleChannel> {
+    let _span = span!(Level::INFO, "build circuit preprocessed tree").entered();
+    let trace = preprocessed_circuit.preprocessed_trace.get_trace::<SimdBackend>();
+    let polys = SimdBackend::interpolate_columns(trace, twiddles);
+    CommitmentTreeProver::new(
+        polys,
+        CIRCUIT_FRI_CONFIG.log_blowup_factor,
+        twiddles,
+        CIRCUIT_STORE_POLYNOMIALS_COEFFICIENTS,
+        circuit_config.config.lifting_log_size,
+        pool,
+    )
+}
